{
  "mcpServers": {
    "mcp-search-console": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${CLAUDE_PLUGIN_ROOT}",
        "--frozen",
        "python",
        "gsc_server.py"
      ],
      "env": {
        "GSC_USE_ADC": "",
        "GSC_CREDENTIALS_PATH": "",
        "GSC_OAUTH_CLIENT_SECRETS_FILE": "",
        "GSC_DATA_STATE": "all"
      }
    }
  }
}
